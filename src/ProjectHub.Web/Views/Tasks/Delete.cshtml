@model TaskDetailsViewModel
@{
    ViewData["Title"] = "删除任务";
    ViewData["ActiveMenu"] = "Tasks";
}

<div class="page-header d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 page-title mb-1">删除任务</h1>
        <p class="page-subtitle mb-0">删除操作不可撤销，请谨慎确认</p>
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-id="@Model.Task.Id">返回详情</a>
</div>

<div class="card">
    <div class="card-body">
        <div class="alert alert-warning mb-4">
            确定要删除任务 <strong>@Model.Task.Name</strong> 吗？此操作不可撤销。
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-2">任务名称</dt>
            <dd class="col-sm-10">@Model.Task.Name</dd>

            <dt class="col-sm-2">所属项目</dt>
            <dd class="col-sm-10">@(Model.Project != null ? Model.Project.Name : "未知项目")</dd>

            <dt class="col-sm-2">截止日期</dt>
            <dd class="col-sm-10">@Model.Task.DueDate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-2">任务状态</dt>
            <dd class="col-sm-10 mb-0">
                <span class="badge @Model.Task.Status.ToBadgeClass()">@Model.Task.Status.GetDisplayName()</span>
            </dd>
        </dl>
    </div>
    <div class="card-footer bg-white text-right">
        <form asp-action="Delete" asp-route-id="@Model.Task.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-danger">确认删除</button>
        </form>
        <a class="btn btn-light" asp-action="Details" asp-route-id="@Model.Task.Id">取消</a>
    </div>
</div>
