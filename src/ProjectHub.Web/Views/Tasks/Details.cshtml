@model TaskDetailsViewModel
@{
    ViewData["Title"] = "任务详情";
    ViewData["ActiveMenu"] = "Tasks";
}

<div class="page-header d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h4 page-title mb-1">@Model.Task.Name</h1>
        <p class="page-subtitle mb-0">任务详情与执行信息</p>
    </div>
    <div class="text-nowrap">
        @if (Model.Project != null)
        {
            <a class="btn btn-outline-secondary btn-sm" asp-controller="Projects" asp-action="Details" asp-route-id="@Model.Project.Id">返回项目</a>
        }
        else
        {
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index">返回列表</a>
        }
        <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@Model.Task.Id">编辑任务</a>
        <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@Model.Task.Id">删除任务</a>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>基础信息</span>
        <span class="badge @Model.Task.Status.ToBadgeClass()">@Model.Task.Status.GetDisplayName()</span>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-2">所属项目</dt>
            <dd class="col-sm-10">
                @if (Model.Project != null)
                {
                    <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.Project.Id">@Model.Project.Name</a>
                }
                else
                {
                    <span class="text-muted">未知项目</span>
                }
            </dd>

            <dt class="col-sm-2">截止日期</dt>
            <dd class="col-sm-10">
                @Model.Task.DueDate.ToString("yyyy-MM-dd")
                @if (Model.Task.Status != ProjectTaskStatus.Completed && Model.Task.DueDate.Date < DateTime.Today)
                {
                    <span class="badge badge-soft-danger ml-1">已逾期</span>
                }
            </dd>

            <dt class="col-sm-2">任务描述</dt>
            <dd class="col-sm-10 text-pre-line">@(string.IsNullOrWhiteSpace(Model.Task.Description) ? "暂无描述" : Model.Task.Description)</dd>

            <dt class="col-sm-2">创建时间</dt>
            <dd class="col-sm-10">@Model.Task.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-2">更新时间</dt>
            <dd class="col-sm-10 mb-0">@Model.Task.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>
    </div>
</div>
