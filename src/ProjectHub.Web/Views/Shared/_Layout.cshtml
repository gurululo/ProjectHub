<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjectHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark app-navbar">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark">P</span>
            ProjectHub
        </a>
        <ul class="navbar-nav mr-auto">
            <li class="nav-item">
                <a class="nav-link" asp-controller="Home" asp-action="Index">首页</a>
            </li>
        </ul>
        <span class="navbar-text text-light small">企业项目管理系统</span>
    </nav>

    <main class="container py-4 app-main">
        @RenderBody()
    </main>

    <footer class="app-footer text-center">
        <div class="container">ProjectHub · ASP.NET Core MVC · @DateTime.Now.Year</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
