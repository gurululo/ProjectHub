@{
    var activeMenu = (ViewData["ActiveMenu"] as string) ?? string.Empty;
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjectHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">P</span>
                ProjectHub
                <span class="brand-sub">企业项目管理</span>
            </a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#topNavigation" aria-controls="topNavigation" aria-expanded="false" aria-label="切换导航">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="topNavigation">
                <ul class="navbar-nav mr-auto app-top-nav">
                    <li class="nav-item">
                        <a class="nav-link @(activeMenu == "Dashboard" ? "active" : "")" asp-controller="Home" asp-action="Index">工作台</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(activeMenu == "Projects" ? "active" : "")" asp-controller="Projects" asp-action="Index">项目管理</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(activeMenu == "Tasks" ? "active" : "")" asp-controller="Tasks" asp-action="Index">任务管理</a>
                    </li>
                </ul>
                <div class="navbar-user">
                    <span class="user-avatar">A</span>
                    <span class="user-name">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                        <button type="submit" class="btn btn-outline-light btn-sm">退出登录</button>
                    </form>
                </div>
            </div>
        </nav>
    </header>

    <div class="app-layout">
        <aside class="app-sidebar">
            <div class="sidebar-section-title">功能菜单</div>
            <nav class="nav flex-column nav-sidebar">
                <a class="nav-link @(activeMenu == "Dashboard" ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <span class="nav-bullet"></span>工作台
                </a>
                <a class="nav-link @(activeMenu == "Projects" ? "active" : "")" asp-controller="Projects" asp-action="Index">
                    <span class="nav-bullet"></span>项目管理
                </a>
                <a class="nav-link @(activeMenu == "Tasks" ? "active" : "")" asp-controller="Tasks" asp-action="Index">
                    <span class="nav-bullet"></span>任务管理
                </a>
            </nav>

            <div class="sidebar-section-title mt-3">快捷操作</div>
            <nav class="nav flex-column nav-sidebar">
                <a class="nav-link" asp-controller="Projects" asp-action="Create">
                    <span class="nav-plus">＋</span>新增项目
                </a>
                <a class="nav-link" asp-controller="Tasks" asp-action="Create">
                    <span class="nav-plus">＋</span>新增任务
                </a>
            </nav>

            <div class="sidebar-footer">
                <div>ProjectHub v1.1</div>
                <div>ASP.NET Core MVC</div>
            </div>
        </aside>

        <main class="app-content">
            <div class="content-inner">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="关闭">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="关闭">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }

                @RenderBody()

                <footer class="app-footer">
                    ProjectHub 企业项目管理系统
                </footer>
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
