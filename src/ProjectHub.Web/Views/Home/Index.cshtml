@{
    ViewData["Title"] = "首页";
}

<div class="app-jumbotron">
    <h1 class="h3 mb-2">欢迎回来，@User.Identity.Name</h1>
    <p class="lead text-muted mb-3">您已通过管理员身份验证，可以开始管理企业项目。</p>
    <hr class="my-4" />
    <p class="text-muted">项目管理模块已上线，可创建并维护项目基础信息。任务管理与首页统计将在后续阶段加入。</p>
    <a class="btn btn-primary" asp-controller="Projects" asp-action="Index">进入项目管理</a>
</div>
