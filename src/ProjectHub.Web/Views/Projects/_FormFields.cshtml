@model Project

<div class="form-group">
    <label asp-for="Name"></label><span class="required-mark">*</span>
    <input asp-for="Name" class="form-control" placeholder="请输入项目名称" />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>

<div class="form-group">
    <label asp-for="Description"></label>
    <textarea asp-for="Description" class="form-control" rows="4" placeholder="简要描述项目目标与范围"></textarea>
    <span asp-validation-for="Description" class="text-danger small"></span>
</div>

<div class="form-row">
    <div class="form-group col-md-6">
        <label asp-for="StartDate"></label><span class="required-mark">*</span>
        <input asp-for="StartDate" class="form-control" />
        <span asp-validation-for="StartDate" class="text-danger small"></span>
    </div>
    <div class="form-group col-md-6">
        <label asp-for="EndDate"></label><span class="required-mark">*</span>
        <input asp-for="EndDate" class="form-control" />
        <span asp-validation-for="EndDate" class="text-danger small"></span>
    </div>
</div>

<div class="form-group mb-0">
    <label asp-for="Status"></label><span class="required-mark">*</span>
    <select asp-for="Status" class="form-control">
        <option value="0" selected="@(Model.Status == ProjectStatus.NotStarted)">未开始</option>
        <option value="1" selected="@(Model.Status == ProjectStatus.InProgress)">进行中</option>
        <option value="2" selected="@(Model.Status == ProjectStatus.Completed)">已完成</option>
    </select>
    <span asp-validation-for="Status" class="text-danger small"></span>
</div>
