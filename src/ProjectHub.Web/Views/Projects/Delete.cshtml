@model Project
@{
    ViewData["Title"] = "删除项目";
}

<div class="page-header d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 page-title mb-1">删除项目</h1>
        <p class="page-subtitle mb-0">删除操作不可撤销，请谨慎确认</p>
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-id="@Model.Id">返回详情</a>
</div>

<div class="card">
    <div class="card-body">
        <div class="alert alert-warning mb-4">
            确定要删除项目 <strong>@Model.Name</strong> 吗？此操作不可撤销。
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-2">项目名称</dt>
            <dd class="col-sm-10">@Model.Name</dd>

            <dt class="col-sm-2">开始日期</dt>
            <dd class="col-sm-10">@Model.StartDate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-2">结束日期</dt>
            <dd class="col-sm-10">@Model.EndDate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-2">项目状态</dt>
            <dd class="col-sm-10 mb-0">
                <span class="badge @Model.Status.ToBadgeClass()">@Model.Status.GetDisplayName()</span>
            </dd>
        </dl>
    </div>
    <div class="card-footer bg-white text-right">
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-danger">确认删除</button>
        </form>
        <a class="btn btn-light" asp-action="Details" asp-route-id="@Model.Id">取消</a>
    </div>
</div>
