@model ProjectDetailsViewModel
@{
    ViewData["Title"] = "删除项目";
    ViewData["ActiveMenu"] = "Projects";
}

<div class="page-header d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 page-title mb-1">删除项目</h1>
        <p class="page-subtitle mb-0">删除操作不可撤销，请谨慎确认</p>
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-id="@Model.Project.Id">返回详情</a>
</div>

<div class="card">
    <div class="card-body">
        <div class="alert alert-warning mb-4">
            确定要删除项目 <strong>@Model.Project.Name</strong> 吗？
            @if (Model.TaskCount > 0)
            {
                <span>该项目下的 <strong>@Model.TaskCount</strong> 个任务也将一并删除。</span>
            }
            此操作不可撤销。
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-2">项目名称</dt>
            <dd class="col-sm-10">@Model.Project.Name</dd>

            <dt class="col-sm-2">开始日期</dt>
            <dd class="col-sm-10">@Model.Project.StartDate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-2">结束日期</dt>
            <dd class="col-sm-10">@Model.Project.EndDate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-2">项目状态</dt>
            <dd class="col-sm-10">@Model.Project.Status.GetDisplayName()</dd>

            <dt class="col-sm-2">关联任务</dt>
            <dd class="col-sm-10 mb-0">@Model.TaskCount 个</dd>
        </dl>
    </div>
    <div class="card-footer bg-white text-right">
        <form asp-action="Delete" asp-route-id="@Model.Project.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-danger">确认删除</button>
        </form>
        <a class="btn btn-light" asp-action="Details" asp-route-id="@Model.Project.Id">取消</a>
    </div>
</div>
