@model ProjectListViewModel
@{
    ViewData["Title"] = "项目管理";
    ViewData["ActiveMenu"] = "Projects";
}

<div class="page-header d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 page-title mb-1">项目管理</h1>
        <p class="page-subtitle mb-0">共 @Model.Items.Count 个项目</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">＋ 新增项目</a>
</div>

<div class="card filter-card mb-3">
    <div class="card-body py-3">
        <form method="get" asp-action="Index" class="form-row align-items-end">
            <div class="col-lg-4 col-md-5 mb-2 mb-md-0">
                <label class="small text-muted mb-1" for="keyword">关键字</label>
                <input type="text" class="form-control form-control-sm" id="keyword" name="keyword" value="@Model.Keyword" placeholder="项目名称或描述" />
            </div>
            <div class="col-lg-3 col-md-3 mb-2 mb-md-0">
                <label class="small text-muted mb-1" for="status">项目状态</label>
                <select class="form-control form-control-sm" id="status" name="status">
                    <option value="" selected="@(Model.Status == null)">全部状态</option>
                    <option value="0" selected="@(Model.Status == ProjectStatus.NotStarted)">未开始</option>
                    <option value="1" selected="@(Model.Status == ProjectStatus.InProgress)">进行中</option>
                    <option value="2" selected="@(Model.Status == ProjectStatus.Completed)">已完成</option>
                </select>
            </div>
            <div class="col-lg-5 col-md-4">
                <button type="submit" class="btn btn-primary btn-sm">查询</button>
                <a class="btn btn-light btn-sm" asp-action="Index">重置</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover app-table mb-0">
            <thead>
                <tr>
                    <th>项目名称</th>
                    <th>项目周期</th>
                    <th>状态</th>
                    <th>任务进度</th>
                    <th class="text-right">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-5">暂无符合条件的项目</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.Items)
                    {
                        var project = item.Project;

                        <tr>
                            <td>
                                <a class="font-weight-bold" asp-action="Details" asp-route-id="@project.Id">@project.Name</a>
                                @if (!string.IsNullOrWhiteSpace(project.Description))
                                {
                                    <div class="text-muted small text-truncate" style="max-width: 360px;">@project.Description</div>
                                }
                            </td>
                            <td>
                                <div>@project.StartDate.ToString("yyyy-MM-dd")</div>
                                <div class="text-muted small">至 @project.EndDate.ToString("yyyy-MM-dd")</div>
                            </td>
                            <td>
                                <span class="badge @project.Status.ToBadgeClass()">@project.Status.GetDisplayName()</span>
                            </td>
                            <td>
                                @if (item.TaskCount == 0)
                                {
                                    <span class="text-muted small">暂无任务</span>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center">
                                        <div class="progress progress-thin flex-grow-1 mr-2" style="min-width: 70px;">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: @(item.Progress)%" aria-valuenow="@item.Progress" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                        <span class="small text-muted text-nowrap">@item.CompletedTaskCount/@item.TaskCount</span>
                                    </div>
                                }
                            </td>
                            <td class="text-right text-nowrap">
                                <a class="btn btn-link btn-sm" asp-action="Details" asp-route-id="@project.Id">查看</a>
                                <a class="btn btn-link btn-sm" asp-action="Edit" asp-route-id="@project.Id">编辑</a>
                                <a class="btn btn-link btn-sm text-danger" asp-action="Delete" asp-route-id="@project.Id">删除</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
