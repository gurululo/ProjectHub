@model IList<Project>
@{
    ViewData["Title"] = "项目管理";
}

<div class="page-header d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 page-title mb-1">项目管理</h1>
        <p class="page-subtitle mb-0">共 @Model.Count 个项目</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">＋ 新增项目</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover app-table mb-0">
            <thead>
                <tr>
                    <th>项目名称</th>
                    <th>开始日期</th>
                    <th>结束日期</th>
                    <th>状态</th>
                    <th class="text-right">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-5">暂无项目，点击右上角“新增项目”开始创建。</td>
                    </tr>
                }
                else
                {
                    foreach (var project in Model)
                    {
                        <tr>
                            <td>
                                <a class="font-weight-bold" asp-action="Details" asp-route-id="@project.Id">@project.Name</a>
                                @if (!string.IsNullOrWhiteSpace(project.Description))
                                {
                                    <div class="text-muted small text-truncate" style="max-width: 360px;">@project.Description</div>
                                }
                            </td>
                            <td>@project.StartDate.ToString("yyyy-MM-dd")</td>
                            <td>@project.EndDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="badge @project.Status.ToBadgeClass()">@project.Status.GetDisplayName()</span>
                            </td>
                            <td class="text-right text-nowrap">
                                <a class="btn btn-link btn-sm" asp-action="Details" asp-route-id="@project.Id">查看</a>
                                <a class="btn btn-link btn-sm" asp-action="Edit" asp-route-id="@project.Id">编辑</a>
                                <a class="btn btn-link btn-sm text-danger" asp-action="Delete" asp-route-id="@project.Id">删除</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
