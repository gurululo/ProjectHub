@model Project
@{
    ViewData["Title"] = "新增项目";
    ViewData["ActiveMenu"] = "Projects";
}

<div class="page-header d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 page-title mb-1">新增项目</h1>
        <p class="page-subtitle mb-0">填写项目基础信息</p>
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">返回列表</a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            @await Html.PartialAsync("_FormFields", Model)

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">保存项目</button>
                <a class="btn btn-light" asp-action="Index">取消</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
