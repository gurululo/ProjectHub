@model Project
@{
    ViewData["Title"] = "项目详情";
}

<div class="page-header d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h4 page-title mb-1">@Model.Name</h1>
        <p class="page-subtitle mb-0">项目详情与基础信息</p>
    </div>
    <div class="text-nowrap">
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index">返回列表</a>
        <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@Model.Id">编辑项目</a>
        <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@Model.Id">删除项目</a>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>基础信息</span>
        <span class="badge @Model.Status.ToBadgeClass()">@Model.Status.GetDisplayName()</span>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-2">项目描述</dt>
            <dd class="col-sm-10 text-pre-line">@(string.IsNullOrWhiteSpace(Model.Description) ? "暂无描述" : Model.Description)</dd>

            <dt class="col-sm-2">开始日期</dt>
            <dd class="col-sm-10">@Model.StartDate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-2">结束日期</dt>
            <dd class="col-sm-10">@Model.EndDate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-2">创建时间</dt>
            <dd class="col-sm-10">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-2">更新时间</dt>
            <dd class="col-sm-10 mb-0">@Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>
    </div>
</div>
